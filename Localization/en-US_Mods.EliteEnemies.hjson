WorldGen: {
	Titles: {
		Scarce: Scarce
		Regular: Regular
		Plentiful: Plentiful
		Ceaseless: Ceaseless
	}

	Descriptions: {
		Scarce: Fewer Elites, for laid-back players
		Regular: The standard Elite Enemies experience
		Plentiful: Many more Elites, not for the faint of heart!
		Ceaseless: All the Elites! Give them hell!
	}

	DescriptionsLong: {
		Scarce:
			'''
			{$WorldGen.Descriptions.Scarce}
			Max variations per NPC: 1
			Variation spawn chance: 5%
			'''
		Regular:
			'''
			{$WorldGen.Descriptions.Regular}
			Max variations per NPC: 3
			Variation spawn chance: 10%
			'''
		Plentiful:
			'''
			{$WorldGen.Descriptions.Plentiful}
			Max variations per NPC: 6
			Variation spawn chance: 25%
			'''
		Ceaseless:
			'''
			{$WorldGen.Descriptions.Ceaseless}
			Max variations per NPC: 10
			Variation spawn chance: 50%
			Each enemy is guaranteed to have at least 1 variation.
			'''
	}
}

