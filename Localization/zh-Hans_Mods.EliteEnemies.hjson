	Titles: {
		// Scarce: 少量
		// Regular: 标准
		// Plentiful: 大量
		// Ceaseless: 无尽
	}

	Descriptions: {
		// Scarce: 少量精英怪，适合休闲玩家
		// Regular: 标准的精英怪体验
		// Plentiful: 更多精英怪，克苏鲁之眼有些饱了！
		// Ceaseless: 到处都是精英怪！史莱姆王的脚底有些痒了！
	}

	DescriptionsLong: {
		/* Scarce:
			'''
			{$WorldGen.Descriptions.Scarce}
